#!/bin/sh
# postrm script for phm
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <postrm> `remove'
#        * <postrm> `purge'
#        * <old-postrm> `upgrade' <new-version>
#        * <new-postrm> `failed-upgrade' <old-version>
#        * <new-postrm> `abort-install'
#        * <new-postrm> `abort-install' <old-version>
#        * <new-postrm> `abort-upgrade' <old-version>
#        * <disappearer's-postrm> `disappear' <overwriter>
#          <overwriter-version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package


case "$1" in
	upgrade)
    ;;

    purge|remove)
        echo "postrm is called with argument \`$1'" 
               #if [ -e /usr/bin/1ccl_benchmark  ]; then
               #         echo "/usr/bin/1ccl_benchmark  exists, deleting"
               #         rm -rf /usr/bin/1ccl_benchmark  > /dev/null 2>&1
               # else
               #         echo "/usr/bin/1ccl_benchmark  doesn't exist"
               # fi

		if [ -d /opt/intel/oneapi/ccl/oneccl_version_replace ]; then
			echo "/opt/intel/oneapi/ccl/oneccl_version_replace exists, deleting"
		    rm -rf /opt/intel/oneapi/ccl/oneccl_version_replace >/dev/null 2>&1
		    cd /opt/intel/oneapi/ccl/ || exit 1
		    ln -snf 2021.15 latest
		else
			echo "/opt/intel/oneapi/ccl/oneccl_version_replace doesn't exist"
		fi
    ;;


esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.



exit 0
